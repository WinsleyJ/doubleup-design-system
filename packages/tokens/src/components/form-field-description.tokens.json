{
  "$description": "Toelichting bij een formulierveld (NL DS Candidate: nl.form-field-description.*).",
  "dup": {
    "form-field-description": {
      "color": {
        "$type": "color",
        "$value": "{basis.color.default.color-subtle}",
        "$extensions": {
          "dup.contrast": [
            {
              "against": "basis.color.default.bg-document",
              "use": "text"
            }
          ]
        }
      },
      "font-family": {
        "$type": "fontFamily",
        "$value": "{basis.text.font-family.default}"
      },
      "font-size": {
        "$type": "dimension",
        "$value": "{basis.text.font-size.sm}"
      },
      "font-weight": {
        "$type": "fontWeight",
        "$value": "{basis.text.font-weight.default}"
      },
      "line-height": {
        "$type": "number",
        "$value": "{basis.text.line-height.sm}"
      },
      "margin-block-end": {
        "$type": "dimension",
        "$value": "{basis.space.text.xs}"
      },
      "margin-block-start": {
        "$type": "dimension",
        "$value": "{basis.space.text.2xs}"
      },
      "disabled": {
        "color": {
          "$type": "color",
          "$value": "{basis.color.disabled.color-subtle}"
        }
      }
    }
  }
}
