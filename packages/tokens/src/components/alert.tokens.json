{
  "$description": "Alert/melding (NL DS Candidate: nl.alert.*); typen error/info/success/warning op basis-rollen negative/info/positive/warning.",
  "dup": {
    "alert": {
      "border-radius": {
        "$type": "dimension",
        "$value": "{basis.border-radius.sm}"
      },
      "border-width": {
        "$type": "dimension",
        "$value": "{basis.border-width.sm}"
      },
      "border-inline-start-width": {
        "$type": "dimension",
        "$value": "{basis.border-width.lg}"
      },
      "column-gap": {
        "$type": "dimension",
        "$value": "{basis.space.column.md}"
      },
      "margin-block-end": {
        "$type": "dimension",
        "$value": "{basis.space.block.md}"
      },
      "margin-block-start": {
        "$type": "dimension",
        "$value": "{basis.space.none}"
      },
      "padding-block-end": {
        "$type": "dimension",
        "$value": "{basis.space.block.md}"
      },
      "padding-block-start": {
        "$type": "dimension",
        "$value": "{basis.space.block.md}"
      },
      "padding-inline-end": {
        "$type": "dimension",
        "$value": "{basis.space.inline.lg}"
      },
      "padding-inline-start": {
        "$type": "dimension",
        "$value": "{basis.space.inline.lg}"
      },
      "heading": {
        "font-size": {
          "$type": "dimension",
          "$value": "{basis.text.font-size.lg}"
        },
        "font-weight": {
          "$type": "fontWeight",
          "$value": "{basis.text.font-weight.bold}"
        },
        "line-height": {
          "$type": "number",
          "$value": "{basis.text.line-height.lg}"
        }
      },
      "icon": {
        "size": {
          "$type": "dimension",
          "$value": "{basis.size.icon.lg}"
        }
      },
      "message": {
        "row-gap": {
          "$type": "dimension",
          "$value": "{basis.space.row.xs}"
        }
      },
      "error": {
        "background-color": {
          "$type": "color",
          "$value": "{basis.color.negative.bg-subtle}"
        },
        "border-color": {
          "$type": "color",
          "$value": "{basis.color.negative.border-default}",
          "$extensions": {
            "dup.contrast": [
              {
                "against": "dup.alert.error.background-color",
                "use": "non-text"
              }
            ]
          }
        },
        "color": {
          "$type": "color",
          "$value": "{basis.color.negative.color-document}",
          "$extensions": {
            "dup.contrast": [
              {
                "against": "dup.alert.error.background-color",
                "use": "text"
              }
            ]
          }
        },
        "icon": {
          "color": {
            "$type": "color",
            "$value": "{basis.color.negative.color-default}",
            "$extensions": {
              "dup.contrast": [
                {
                  "against": "dup.alert.error.background-color",
                  "use": "non-text"
                }
              ]
            }
          }
        }
      },
      "info": {
        "background-color": {
          "$type": "color",
          "$value": "{basis.color.info.bg-subtle}"
        },
        "border-color": {
          "$type": "color",
          "$value": "{basis.color.info.border-default}",
          "$extensions": {
            "dup.contrast": [
              {
                "against": "dup.alert.info.background-color",
                "use": "non-text"
              }
            ]
          }
        },
        "color": {
          "$type": "color",
          "$value": "{basis.color.info.color-document}",
          "$extensions": {
            "dup.contrast": [
              {
                "against": "dup.alert.info.background-color",
                "use": "text"
              }
            ]
          }
        },
        "icon": {
          "color": {
            "$type": "color",
            "$value": "{basis.color.info.color-default}",
            "$extensions": {
              "dup.contrast": [
                {
                  "against": "dup.alert.info.background-color",
                  "use": "non-text"
                }
              ]
            }
          }
        }
      },
      "success": {
        "background-color": {
          "$type": "color",
          "$value": "{basis.color.positive.bg-subtle}"
        },
        "border-color": {
          "$type": "color",
          "$value": "{basis.color.positive.border-default}",
          "$extensions": {
            "dup.contrast": [
              {
                "against": "dup.alert.success.background-color",
                "use": "non-text"
              }
            ]
          }
        },
        "color": {
          "$type": "color",
          "$value": "{basis.color.positive.color-document}",
          "$extensions": {
            "dup.contrast": [
              {
                "against": "dup.alert.success.background-color",
                "use": "text"
              }
            ]
          }
        },
        "icon": {
          "color": {
            "$type": "color",
            "$value": "{basis.color.positive.color-default}",
            "$extensions": {
              "dup.contrast": [
                {
                  "against": "dup.alert.success.background-color",
                  "use": "non-text"
                }
              ]
            }
          }
        }
      },
      "warning": {
        "background-color": {
          "$type": "color",
          "$value": "{basis.color.warning.bg-subtle}"
        },
        "border-color": {
          "$type": "color",
          "$value": "{basis.color.warning.border-default}",
          "$extensions": {
            "dup.contrast": [
              {
                "against": "dup.alert.warning.background-color",
                "use": "non-text"
              }
            ]
          }
        },
        "color": {
          "$type": "color",
          "$value": "{basis.color.warning.color-document}",
          "$extensions": {
            "dup.contrast": [
              {
                "against": "dup.alert.warning.background-color",
                "use": "text"
              }
            ]
          }
        },
        "icon": {
          "color": {
            "$type": "color",
            "$value": "{basis.color.warning.color-default}",
            "$extensions": {
              "dup.contrast": [
                {
                  "against": "dup.alert.warning.background-color",
                  "use": "non-text"
                }
              ]
            }
          }
        }
      }
    }
  }
}
