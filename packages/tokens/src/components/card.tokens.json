{
  "$description": "Card (geen NL DS Candidate-tegenhanger; eigen dup-component). Ook als klikbare kaart (hover).",
  "dup": {
    "card": {
      "background-color": {
        "$type": "color",
        "$value": "{basis.color.default.bg-subtle}"
      },
      "border-color": {
        "$type": "color",
        "$value": "{basis.color.default.border-subtle}"
      },
      "border-radius": {
        "$type": "dimension",
        "$value": "{basis.border-radius.md}"
      },
      "border-width": {
        "$type": "dimension",
        "$value": "{basis.border-width.none}"
      },
      "box-shadow": {
        "$type": "shadow",
        "$value": "{basis.box-shadow.none}"
      },
      "color": {
        "$type": "color",
        "$value": "{basis.color.default.color-document}",
        "$extensions": {
          "dup.contrast": [
            {
              "against": "dup.card.background-color",
              "use": "text"
            }
          ]
        }
      },
      "padding-block": {
        "$type": "dimension",
        "$value": "{basis.space.block.xl}"
      },
      "padding-inline": {
        "$type": "dimension",
        "$value": "{basis.space.inline.xl}"
      },
      "row-gap": {
        "$type": "dimension",
        "$value": "{basis.space.row.sm}"
      },
      "hover": {
        "background-color": {
          "$type": "color",
          "$value": "{basis.color.default.bg-default}"
        },
        "box-shadow": {
          "$type": "shadow",
          "$value": "{basis.box-shadow.md}"
        }
      },
      "subtle": {
        "color": {
          "$type": "color",
          "$value": "{basis.color.default.color-subtle}",
          "$extensions": {
            "dup.contrast": [
              {
                "against": "dup.card.background-color",
                "use": "text"
              },
              {
                "against": "dup.card.hover.background-color",
                "use": "text"
              }
            ]
          }
        }
      }
    }
  }
}
