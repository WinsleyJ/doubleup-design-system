{
  "$description": "Brand-laag DoubleUP: alles behalve kleuren (zie brand-color.tokens.json) en font-families (volgt na keuze in stap 1).",
  "brand": {
    "space": {
      "$type": "dimension",
      "0": {
        "$value": "0rem"
      },
      "50": {
        "$value": "0.125rem",
        "$description": "2px"
      },
      "100": {
        "$value": "0.25rem",
        "$description": "4px"
      },
      "200": {
        "$value": "0.5rem",
        "$description": "8px"
      },
      "300": {
        "$value": "0.75rem",
        "$description": "12px"
      },
      "400": {
        "$value": "1rem",
        "$description": "16px"
      },
      "500": {
        "$value": "1.5rem",
        "$description": "24px"
      },
      "600": {
        "$value": "2rem",
        "$description": "32px"
      },
      "700": {
        "$value": "3rem",
        "$description": "48px"
      },
      "800": {
        "$value": "4rem",
        "$description": "64px"
      },
      "900": {
        "$value": "6rem",
        "$description": "96px"
      },
      "1000": {
        "$value": "8rem",
        "$description": "128px"
      }
    },
    "radius": {
      "$type": "dimension",
      "none": {
        "$value": "0rem"
      },
      "s": {
        "$value": "0.375rem",
        "$description": "6px: invoervelden, kleine vlakken"
      },
      "m": {
        "$value": "0.75rem",
        "$description": "12px: kaarten, containers"
      },
      "l": {
        "$value": "1.25rem",
        "$description": "20px: zelfde verhouding als het app-icoon"
      },
      "pill": {
        "$value": "999px",
        "$description": "Interactieve elementen; sluit aan op de ronde lijneinden in het logo"
      }
    },
    "border-width": {
      "$type": "dimension",
      "s": {
        "$value": "1px"
      },
      "m": {
        "$value": "2px"
      },
      "l": {
        "$value": "3px"
      }
    },
    "opacity": {
      "$type": "number",
      "subtle": {
        "$value": 0.38,
        "$description": "Dekking van de tweede U in de 'lagen'-logovariant"
      },
      "disabled": {
        "$value": 0.6
      }
    },
    "shadow": {
      "$type": "shadow",
      "s": {
        "$value": {
          "color": "#11131814",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        }
      },
      "m": {
        "$value": {
          "color": "#1113181a",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "12px",
          "spread": "0px"
        }
      },
      "l": {
        "$value": {
          "color": "#11131824",
          "offsetX": "0px",
          "offsetY": "12px",
          "blur": "32px",
          "spread": "0px"
        }
      }
    },
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "120ms"
      },
      "normal": {
        "$value": "200ms"
      },
      "slow": {
        "$value": "320ms"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [0.2, 0, 0, 1]
      }
    },
    "font-weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      },
      "black": {
        "$value": 800
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.1
      },
      "snug": {
        "$value": 1.3
      },
      "normal": {
        "$value": 1.55
      }
    },
    "font-size": {
      "$type": "dimension",
      "$description": "Vloeiende typeschaal: 360px → 1280px viewport. Basis 16 → 18px; verhouding ~1,2 (mobiel) → ~1,333 (desktop).",
      "sm": {
        "$value": "clamp(0.875rem, 0.85rem + 0.11vw, 0.9375rem)",
        "$description": "14 → 15px"
      },
      "md": {
        "$value": "clamp(1rem, 0.95rem + 0.22vw, 1.125rem)",
        "$description": "16 → 18px (lopende tekst)"
      },
      "lg": {
        "$value": "clamp(1.2rem, 1.1rem + 0.43vw, 1.5rem)",
        "$description": "19 → 24px"
      },
      "xl": {
        "$value": "clamp(1.44rem, 1.25rem + 0.85vw, 2rem)",
        "$description": "23 → 32px"
      },
      "2xl": {
        "$value": "clamp(1.73rem, 1.4rem + 1.47vw, 2.67rem)",
        "$description": "28 → 43px"
      },
      "3xl": {
        "$value": "clamp(2.07rem, 1.55rem + 2.33vw, 3.55rem)",
        "$description": "33 → 57px"
      },
      "4xl": {
        "$value": "clamp(2.49rem, 1.7rem + 3.5vw, 4.74rem)",
        "$description": "40 → 76px"
      }
    },
    "size": {
      "$type": "dimension",
      "pointer-target": {
        "$value": "2.75rem",
        "$description": "44px: minimale aanraakdoelgrootte (WCAG 2.5.8 vraagt 24px; 44px is ons uitgangspunt)"
      },
      "page": {
        "$value": "75rem",
        "$description": "1200px: maximale paginabreedte"
      },
      "measure": {
        "$value": "40rem",
        "$description": "Maximale breedte invoervelden"
      }
    }
  }
}
